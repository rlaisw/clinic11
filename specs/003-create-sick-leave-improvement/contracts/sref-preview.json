{
  "openapi": "3.0.0",
  "info": {
    "title": "SREF Preview API",
    "version": "1.0.0",
    "description": "API for previewing the next Sick Leave Reference (SREF) number"
  },
  "paths": {
    "/api/sref-preview/": {
      "get": {
        "summary": "Get preview of next SREF",
        "description": "Returns the next SREF that would be assigned to a new certificate without creating it",
        "security": [{"BearerAuth": []}],
        "responses": {
          "200": {
            "description": "Next SREF preview",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sref": {
                      "type": "string",
                      "description": "Next SREF value (format: S{year}-{XXXX}-{XXXX}-{XXXX})",
                      "example": "S001-0000-0001-0001"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden - Doctor permission required"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
